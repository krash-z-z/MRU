{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "MRU",
	"description": "High-performance GPU-accelerated 2D rendering engine for Fabric with MSDF typography, continuous-curvature SDF squircles, and multi-pass blur post-processing.",
	"authors": [
		"krash"
	],
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}